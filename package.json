{
  "name": "solace-practice",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "npm install --prefix api && npm install --prefix web",
    "db:up": "docker compose --env-file api/.env up -d",
    "db:down": "docker compose --env-file api/.env down",
    "api": "npm run start:dev --prefix api",
    "web": "npm run dev --prefix web",
    "dev": "concurrently -n api,web -c blue,green \"npm run api\" \"npm run web\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
